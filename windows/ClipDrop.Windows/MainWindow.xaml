<Window x:Class="ClipDrop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipDrop"
        Width="420" Height="240"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
        <TextBlock Text="ClipDrop" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="Clipboard and files between your phone and PC, over your own Wi-Fi."
                   Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
</Window>
