<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names read as sentences: Unknown_codes_are_not_defined. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipDrop.Core\ClipDrop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The golden vectors shared with the Android test suite (docs/PROTOCOL.md §16). -->
  <ItemGroup>
    <None Include="..\..\docs\test-vectors\*.json" LinkBase="TestVectors" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
