<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+ blocks LAN traffic for apps targeting API 37 unless this runtime permission
         (NEARBY_DEVICES group) is granted. Older platforms ignore it. -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:ignore="UnusedAttribute" />
    <!-- Only used to scan the pairing QR code. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- The foreground service that keeps PCs connected (type connectedDevice: no daily limit). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Satisfies the connectedDevice runtime prerequisite on Android 14+; mDNS will use it too. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The service's status notification and its Send clipboard action (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pairing also works through a clipdrop://pair link, so a camera isn't required. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Pairing data and history stay on the device: no cloud backup and no
         device-to-device transfer. dataExtractionRules covers Android 12+,
         allowBackup and fullBackupContent cover Android 10 and 11. -->
    <application
        android:name=".ClipDropApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClipDrop">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A pairing QR code scanned with the system camera opens the app on the pairing
                 screen, which always asks the user to confirm. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="clipdrop"
                    android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Invisible: gains focus just long enough to read the clipboard (Android 10+ rule).
             Its own empty task affinity keeps it from bringing the app's task forward. -->
        <activity
            android:name=".clipboard.SendClipboardActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ClipDrop.Invisible" />

        <service
            android:name=".service.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".clipboard.ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_send_clipboard"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- An action tile, not an on/off switch. -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
