<?xml version="1.0" encoding="utf-8"?>
<!-- Paired-device pins, history and settings never leave the phone. The
     identity key lives in the AndroidKeyStore and can't be backed up anyway;
     restoring pins without it would only produce broken pairings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
